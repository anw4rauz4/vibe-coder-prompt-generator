# Contoh variabel lingkungan untuk engine DAN (semua OPSIONAL).
# Salin menjadi .env bila perlu; jangan commit .env asli.

# Root workspace tempat deliverables/ ditulis.
# Bila kosong, engine menurunkannya dari lokasi script (.. / .. / ..).
DAN_ROOT=

# (opsional) override lokasi galeri chart dari svg_charts.py
DAN_OUT=
